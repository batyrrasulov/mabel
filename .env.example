# Core service
MABEL_HOST=127.0.0.1
MABEL_PORT=8820
MABEL_STORE_MODE=memory
# MABEL_DB_URL=postgresql://mabel:${MABEL_POSTGRES_PASSWORD}@127.0.0.1:5432/mabel
MABEL_POSTGRES_PASSWORD=

# Local development identity. Use trusted_headers behind an identity-aware proxy.
MABEL_AUTH_MODE=development
MABEL_DEV_USER_EMAIL=developer@mabel.local
MABEL_DEV_USER_ID=local-developer
MABEL_DEV_USER_NAME=Mabel Developer

# OpenAI Agents SDK
OPENAI_API_KEY=
MABEL_OPENAI_MODEL=gpt-5.5
MABEL_OPENAI_AGENTS_ENABLED=true
MABEL_OPENAI_WEB_SEARCH_ENABLED=true
MABEL_OPENAI_CODE_INTERPRETER_ENABLED=true
MABEL_OPENAI_IMAGE_GENERATION_ENABLED=false
MABEL_OPENAI_FILE_SEARCH_ENABLED=false
MABEL_OPENAI_VECTOR_STORE_IDS_JSON=[]
MABEL_TRACE_INCLUDE_SENSITIVE_DATA=false

# Persistence and files
MABEL_SESSION_DB_PATH=./var/mabel-sessions.db
MABEL_UPLOADS_DIR=./var/mabel-uploads
MABEL_UPLOADS_MAX_BYTES=26214400

# MCP connectors
MABEL_LOCAL_MCP_ENDPOINTS_JSON={}
MABEL_MCP_GATEWAY_PROXY_BASE_URL=
MABEL_MCP_GATEWAY_PROFILE=default
MABEL_REMOTE_GATEWAY_API_BASE_URL=
MABEL_REMOTE_GATEWAY_ORG=
MABEL_REMOTE_GATEWAY_RUNTIME_TOKEN=
MABEL_MCP_TOOL_POLICY_RULES_JSON=[]
MABEL_MCP_TOOL_BLOCKLIST_JSON=[]

# Optional GitHub-backed skills registry
MABEL_GITHUB_REPO=batyrrasulov/Mabel
MABEL_SKILLS_GITHUB_REPO=batyrrasulov/Mabel
MABEL_SKILLS_GITHUB_REF=main
MABEL_SKILLS_GITHUB_BASE_PATH=packages/skills
MABEL_GITHUB_TOKEN=

# Web development
VITE_MABEL_API_URL=http://127.0.0.1:8820
VITE_MABEL_API_PREFIX=/mabel-api
VITE_PORT=5173
VITE_MABEL_DEV_USER_EMAIL=developer@mabel.local
VITE_MABEL_DEV_USER_ID=local-developer
VITE_MABEL_DEV_USER_NAME=Mabel Developer
VITE_MABEL_SALESFORCE_BASE_URL=
